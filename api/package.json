{
  "name": "@voicepractice/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:video-worker": "tsx watch src/videoProcessingWorker.ts",
    "build": "tsc -p tsconfig.json && node ./scripts/copy-sql.mjs",
    "start": "node dist/index.js",
    "start:video-worker": "node dist/videoProcessingWorker.js",
    "run:focus-topic-reminders": "node dist/focusTopicReminderWorker.js",
    "seed:dashboard-local": "node ./scripts/seed-dashboard-local.mjs",
    "db:sanitize-bootstrap": "tsx ./scripts/sanitize-bootstrap.ts",
    "force:mobile-reonboarding": "tsx ./scripts/force-mobile-reonboarding.ts",
    "cleanup:training-content": "tsx ./scripts/cleanup-training-content-storage.ts",
    "backup:reconcile-training-content": "tsx ./scripts/reconcile-training-content-backup.ts",
    "db:migrate-training-packs": "tsx ./scripts/migrate-training-pack-schema.ts",
    "db:backfill-focus-topic-authority": "tsx ./scripts/backfill-focus-topic-authority.ts",
    "smoke:training-content-r2": "tsx ./scripts/smoke-training-content-r2.ts",
    "test:postgres:training-content": "tsx --test src/storage/trainingContentPostgres.integration.test.ts",
    "test:postgres:training-packs": "tsx --test src/storage/trainingPackMigrations.integration.test.ts",
    "test:postgres:app-state": "tsx --test src/storage/appStateTransaction.integration.test.ts",
    "test:postgres:product-settings": "tsx --test src/storage/organizationProductSettingsPostgres.integration.test.ts",
    "test:postgres:focus-topic-authority": "tsx --test src/storage/focusTopicAuthorityPostgres.integration.test.ts",
    "test:postgres:customer-scenarios": "tsx --test src/storage/customerPracticeScenarioPostgres.integration.test.ts",
    "test:postgres:notifications": "tsx --test src/storage/userNotificationAppStatePostgres.integration.test.ts",
    "reset:simulation-baseline": "tsx ./scripts/reset-simulation-baseline.ts",
    "reset:pretester-history": "tsx ./scripts/reset-pretester-history.ts --local-file",
    "test": "node ../scripts/run-tsx-tests.mjs src=.test.ts scripts=.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@voicepractice/shared": "file:../shared",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-async-errors": "^3.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "multer": "2.5.0",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
