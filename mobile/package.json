{
  "name": "@voicepractice/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node ../scripts/run-tsx-tests.mjs src=.test.ts scripts=.test.mjs",
    "postinstall": "node ./scripts/apply-react-native-pdf-ios-codegen-patch.mjs && node ./scripts/apply-react-native-pdf-android-gesture-patch.mjs",
    "eas-build-post-install": "node ./scripts/apply-react-native-pdf-ios-codegen-patch.mjs && node ./scripts/apply-react-native-pdf-android-gesture-patch.mjs && npm --prefix .. run build:shared"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "14.0.2",
    "@config-plugins/react-native-pdf": "14.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@voicepractice/shared": "file:../shared",
    "expo": "^58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-blob-util": "0.25.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-pdf": "7.0.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "private": true
}
