{
  "name": "@voicepractice/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node ../scripts/run-tsx-tests.mjs src=.test.ts scripts=.test.mjs",
    "postinstall": "node ./scripts/apply-react-native-pdf-ios-codegen-patch.mjs && node ./scripts/apply-react-native-pdf-android-gesture-patch.mjs",
    "eas-build-post-install": "node ./scripts/apply-react-native-pdf-ios-codegen-patch.mjs && node ./scripts/apply-react-native-pdf-android-gesture-patch.mjs && npm --prefix .. run build:shared"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "14.0.2",
    "@config-plugins/react-native-pdf": "14.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@voicepractice/shared": "file:../shared",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "0.21.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "6.7.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
